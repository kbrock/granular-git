#!/bin/bash
# This tests what the ro profile can do: push is refused, and the gh token has no repo scope.
# Run this from a process that should get the read-only profile, for example from inside a Claude session.
# Run it inside a clone of a repo you can push to, public or private.
# It changes nothing on GitHub: a push with --dry-run, and one read. Prints PASS or FAIL per check and no tokens.
# Exits 1 if anything failed.

dir=$(cd "$(dirname "$0")" && pwd)
bin=$(dirname "$(command -v granular-git || echo "$dir/build/granular-git")")
repo=$(git rev-parse --show-toplevel) || exit 1
git -C "$repo" remote get-url origin >/dev/null || exit 1
helper=(-c credential.helper= -c "credential.helper=$bin/granular-git")
fails=0

check() {
  local desc=$1
  shift
  if "$@" >/dev/null 2>&1; then
    echo "PASS  $desc"
  else
    echo "FAIL  $desc"
    fails=$((fails + 1))
  fi
}

push_out=$(git -C "$repo" "${helper[@]}" push --dry-run 2>&1)
push_status=$?
gh_out=$(gh api -i user 2>&1)

push_refused() { [ "$push_status" -ne 0 ]; }
push_shows_message() { grep -q "^granular: " <<<"$push_out"; }
gh_reads() { head -1 <<<"$gh_out" | grep -q ' 200'; }
gh_token_is_not_classic() { ! grep -qi '^x-oauth-scopes:.*repo' <<<"$gh_out"; }

echo "read-only profile ($repo)"
check "push is refused" push_refused
check "push shows the profile message" push_shows_message
check "gh can read" gh_reads
check "gh holds a token without the repo scope" gh_token_is_not_classic

[ "$fails" -eq 0 ]
