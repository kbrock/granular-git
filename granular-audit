#!/bin/bash
# This ensures the machine is set up correctly: helper chain, no stray credential stores, vault and
# items, gh link order. It calls the tool only to confirm it is wired in. It does not test what ro or rw
# can do (that is granular-test-ro and granular-test-rw).
# Read-only. Run it from your own terminal. Each failure prints the command that fixes it. Exits 1 if
# anything failed.

helper=$(command -v granular-git)
req='protocol=https\nhost=github.com\n\n'
real_gh=$(brew --prefix gh 2>/dev/null)/bin/gh
vault_path=$HOME/Library/Keychains/granular.keychain-db
fails=0
ok=1
RO_MESSAGE="You don't currently have access to push to github. Stop and ask for access."

# check <text when it holds> <text when it does not> <fix> <command...>
check() {
  local pass=$1 fail=$2 fix=$3
  shift 3
  if "$@" >/dev/null 2>&1; then
    ok=1
    echo "PASS  $pass"
  else
    ok=0
    echo "FAIL  $fail"
    echo "      fix: $fix"
    fails=$((fails + 1))
  fi
}

helper_blank() { (cd / && git config --get-all credential.helper) | grep -qx ''; }
helper_last() { [ "$(cd / && git config --get-all credential.helper | tail -1)" = "$helper" ]; }
effective_helpers() { (cd / && git config --get-all credential.helper) | awk '$0 == "" { n = 0; next } { h[++n] = $0 } END { for (i = 1; i <= n; i++) print h[i] }'; }
only_helper() { [ "$(effective_helpers)" = "$helper" ]; }
no_url_helpers() { [ -z "$(cd / && git config --get-regexp '^credential\..+\.helper$')" ]; }
no_netrc() { ! grep -qs github.com "$HOME/.netrc"; }
no_git_credentials() { ! grep -qs github.com "$HOME/.git-credentials" "$HOME/.config/git/credentials"; }
vault_exists() { [ -e "$vault_path" ]; }
vault_item() {
  local svc=granular:$1:github.com out
  if out=$(security find-generic-password -s "$svc" "$vault_path" 2>/dev/null); then
    [ "$1" = rw ] && rw_in_vault=1
    echo "INFO  $svc  $(sed -n 's/.*"acct"<blob>="\(.*\)"/\1/p' <<<"$out")"
  else
    ok=0
    fails=$((fails + 1))
    echo "FAIL  $svc missing"
    echo "      fix: $2"
  fi
}
daemon_answers() { printf 'get github.com\n' | nc -U -w 60 "$HOME/.granular/sock" | grep -q '^ok '; }
git_fills() { (cd / && printf "$req" | GIT_TERMINAL_PROMPT=0 git credential fill) | grep -q '^password=.'; }

no_osx_item() { ! security find-internet-password -s github.com; }
osx_returns_nothing() { [ -z "$(printf "$req" | git credential-osxkeychain get 2>/dev/null)" ]; }

no_gh_item() { ! security find-generic-password -s gh:github.com; }
real_gh_exists() { [ -x "$real_gh" ]; }
no_token_env() { ! env | grep -qE '^(GH|GITHUB)_TOKEN='; }
no_hosts_token() { ! grep -qs oauth_token "$HOME/.config/gh/hosts.yml"; }
helper_on_path() { [ -n "$helper" ]; }
first_gh() { [ "$(readlink -f "$(command -v gh)")" = "$(readlink -f "$helper")" ]; }
gh_authenticated() { gh api user; }

move_rw='user=$(security find-internet-password -s github.com | sed -n '"'"'s/.*"acct"<blob>="\(.*\)"/\1/p'"'"'); pw=$(security find-internet-password -s github.com -w); printf '"'"'%s\n%s\n'"'"' "$user" "$pw" | granular-passwd --stdin rw github.com; unset pw'

version=$("${helper:-false}" --version 2>/dev/null)
echo "granular ${version:-unknown (older build)}"

echo "## granular-git"
if ! helper_on_path; then
  echo "FAIL  not installed"
  echo "      fix: put granular-git on PATH, for example in /usr/local/bin"
  exit 1
fi
echo "PASS  installed ($helper)"
check "credential fill works" "credential fill fails" "see the vault and daemon below" git_fills

echo "## credential.helper"
reset_helper="git config --global --unset-all credential.helper; git config --global --add credential.helper ''; git config --global --add credential.helper $helper"
last=$(cd / && git config --get-all credential.helper | tail -1)
others=$(effective_helpers | grep -vx "$helper" | tr '\n' ' ')
check "starts with a blank" "no leading blank" "$reset_helper" helper_blank
check "ends with granular-git" "ends with ${last:-nothing}" "$reset_helper" helper_last
check "no other helpers" "other helpers: $others" "git config --show-origin --get-all credential.helper, then remove the others" only_helper
check "no URL helper" "URL helper set" "git config --show-origin --get-regexp 'credential\\..+\\.helper', then unset each" no_url_helpers

echo "## granular-daemon"
if daemon_answers >/dev/null 2>&1; then
  echo "PASS  answers"
else
  echo "NOTE  no daemon running: blacklist=[claude, claude code]"
fi

rw_in_vault=0
if no_osx_item >/dev/null 2>&1; then osx_item=0; else osx_item=1; fi

tilde="~"
echo "## vault (${vault_path/#$HOME/$tilde})"
check "exists" "missing" "granular-passwd ro github.com \"$RO_MESSAGE\"" vault_exists
if [ "$ok" = 0 ]; then
  echo "      start here: the checks below need the vault"
  exit 1
fi
vault_item ro "granular-passwd ro github.com \"$RO_MESSAGE\""
if [ "$osx_item" = 1 ]; then
  vault_item rw "$move_rw"
else
  vault_item rw "granular-passwd rw github.com"
fi

echo "## stored credentials"
if [ "$rw_in_vault" = 1 ]; then
  erase_osx="printf '$req' | git credential-osxkeychain erase"
else
  erase_osx="add rw to the vault first, then: printf '$req' | git credential-osxkeychain erase"
fi
check "no osxkeychain github.com item" "osxkeychain has a github.com item" "$erase_osx" no_osx_item
[ "$ok" = 1 ] && check "osxkeychain returns nothing" "osxkeychain returns a credential" "$erase_osx" osx_returns_nothing
check "~/.netrc has no github.com" "~/.netrc has github.com" "remove the github.com lines" no_netrc
check "~/.git-credentials has no github.com" "~/.git-credentials has github.com" "remove github.com from ~/.git-credentials and ~/.config/git/credentials" no_git_credentials

echo "## gh"
check "real gh installed ($real_gh)" "real gh not installed" "brew install gh && brew unlink gh" real_gh_exists
check "wrapper first on PATH" "wrapper not first on PATH" "brew unlink gh, or reorder PATH: type -ap gh" first_gh
check "wrapper works" "wrapper fails" "granular-passwd ro github.com and rw github.com" gh_authenticated
check "no GH_TOKEN or GITHUB_TOKEN" "GH_TOKEN or GITHUB_TOKEN set" "unset them" no_token_env
check "no keyring item" "keyring item exists" "gh auth logout -h github.com" no_gh_item
[ "$ok" = 1 ] && check "hosts.yml has no oauth_token" "hosts.yml has oauth_token" "gh auth logout -h github.com" no_hosts_token

[ "$fails" -eq 0 ]
